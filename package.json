{
  "name": "pro-instrument",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lint": "eslint . --max-warnings=0 && go -C apps/backend vet ./...",
    "typecheck": "pnpm --recursive --if-present run typecheck && go -C apps/backend test ./... -run '^$'",
    "test": "pnpm --recursive --if-present run test && go -C apps/backend test ./..."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.2.17",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
