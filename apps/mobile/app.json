{
  "expo": {
    "name": "Про Инструмент",
    "slug": "pro-instrument",
    "scheme": "pro-instrument",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите выбрать фотографию документа.",
          "cameraPermission": "Разрешите сделать фотографию документа."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "ru.proinstrument.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Разрешите сделать фотографию документа.",
        "NSPhotoLibraryUsageDescription": "Разрешите выбрать фотографию документа.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "ru.proinstrument.mobile",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4c62522-7800-4c1c-ada6-a55c18af8758"
      }
    }
  }
}
