PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5434/pro_instrument?sslmode=disable
OTP_TTL=5m
SESSION_TTL=720h
APP_ENV=development
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=10485760
RENTAL_HOLD_TTL=30m
COURIER_DELIVERY_FEE_KOPECKS=100000
PICKUP_ADDRESS=Москва, ул. Примерная, д. 1

DEMO_MODE_ENABLED=false
DEMO_OTP_CODE=654321
DEMO_OTP_PHONES=+79990000077

YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=replace-with-shop-id
YOOKASSA_SECRET_KEY=replace-with-yookassa-secret-key
YOOKASSA_RETURN_URL=pro-instrument://payment-return
YOOKASSA_RECEIPTS_ENABLED=false
YOOKASSA_TAX_SYSTEM_CODE=2
YOOKASSA_VAT_CODE=1
PUBLIC_BASE_URL=https://api.example.com
YOOKASSA_POLL_INTERVAL=5s

